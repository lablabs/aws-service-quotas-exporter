{
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "No cooldown for lablabs-owned packages",
      "matchPackageNames": [
        "lablabs/**",
        "ghcr.io/lablabs/**"
      ],
      "minimumReleaseAge": "0 days"
    }
  ],
  "vulnerabilityAlerts": {
    "addLabels": [
      "security"
    ]
  },
  "enabledManagers": [
    "asdf",
    "gomod",
    "dockerfile",
    "github-actions"
  ]
}
